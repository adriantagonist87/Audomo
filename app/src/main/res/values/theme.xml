<resources>
    <style name="AudomoTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0B2B</item>
        <item name="android:alertDialogTheme">@style/AudomoAlertTheme</item>
        <item name="android:colorAccent">#B89AFF</item>
        <item name="android:statusBarColor">#0D0B2B</item>
        <item name="android:navigationBarColor">#0D0B2B</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AudomoAlertTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorAccent">#B89AFF</item>
    </style>
    <style name="ProfileFieldTheme" parent="@style/AudomoTheme">
        <item name="android:spinnerStyle">@style/ProfileField</item>
    </style>
    <style name="QuickCaptureTheme" parent="@style/AudomoTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="ProfileField" parent="@android:style/Widget.Material.Spinner">
        <item name="android:overlapAnchor">false</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>
